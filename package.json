{
  "name": "g-os-extension",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && tsc -p tsconfig.json && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json && tsc -p tsconfig.compat.json",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs",
    "test:coverage": "npm run build && node scripts/test-coverage.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "build:deploy": "bash scripts/build-deploy.sh",
    "dev:check": "bash scripts/dev-check.sh",
    "dev": "bash scripts/dev-session.sh",
    "dev:watch": "bash scripts/dev-watch.sh",
    "dev:install:fedora": "bash scripts/install-dev-deps-fedora.sh",
    "dev:install:cachyos": "bash scripts/install-dev-deps-cachyos.sh",
    "debug:check": "npm run build && node scripts/check-debug-artifacts.mjs",
    "debug:gnome-logs": "node scripts/check-gnome-logs.mjs"
  },
  "devDependencies": {
    "@girs/gjs": "^5.6.0",
    "@girs/gnome-shell": "^51.0.1",
    "@types/mustache": "^4.2.6",
    "esbuild": "^0.28.2",
    "fast-xml-parser": "^5.12.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@lezer/python": "^1.1.19",
    "blessed": "^0.1.81",
    "json5": "^2.2.3",
    "mustache": "^4.2.0",
    "yaml": "^2.9.1"
  }
}
