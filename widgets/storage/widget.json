{
  "apiVersion": 1, "id": "storage", "name": "Stockage", "description": "Espace libre et utilise du disque contenant un dossier.",
  "entry": "widget.js", "preview": "preview.svg", "css": "widget.css", "targets": ["desktop", "dock"],
  "size": {"columns": 8, "rows": 6}, "minimum": {"width": 240, "height": 176},
  "configuration": [
    {"key": "path", "title": "Dossier du disque", "type": "text", "default": "~"},
    {"key": "interval", "title": "Rafraichissement (secondes)", "type": "number", "min": 5, "max": 300, "step": 5, "default": 30}
  ]
}